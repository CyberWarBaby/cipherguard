# ==============================================================================
# CipherGuard: Environment Configuration Template
# ==============================================================================

# Environment mode (development / staging / production)
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Service Role Key (Required for backend server operations)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Supabase Anonymous Public Key
SUPABASE_KEY=your_supabase_anon_key_here

# Supabase JWT Secret (Used to verify authorization tokens from Supabase Auth)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# ------------------------------------------------------------------------------
# Application Security & Networking
# ------------------------------------------------------------------------------
# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# Default Tenant Organization ID (used for demo fallback)
DEFAULT_ORG_ID=a0000000-0000-0000-0000-000000000001

# ------------------------------------------------------------------------------
# Gateway & Upstream Third-Party Endpoints (Multi-Host / VPS Deployments)
# ------------------------------------------------------------------------------
# Public entrypoint URL (Kong Gateway)
CIPHERGUARD_GATEWAY_URL=http://localhost:8000

# Upstream Third-Party API Endpoints
# In single-node Docker Compose, use internal hostnames: http://shipfast-api:8000
# In multi-VPS deployments, configure the remote public IP/domain of the third-party service:
# e.g., http://192.0.2.55:8002 or https://api.shipfast.example.com
SHIPFAST_UPSTREAM_URL=http://shipfast-api:8000
PAYFLEX_UPSTREAM_URL=http://payflex-api:8000

# Allow internal demo hostnames in local/docker environment (true for dev/demo, false in strict prod)
ALLOW_INTERNAL_NETWORKS=true

