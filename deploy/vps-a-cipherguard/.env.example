# ==============================================================================
# VPS A — CIPHERGUARD ENVIRONMENT CONFIGURATION
# ==============================================================================
ENVIRONMENT=production

# Public URL of this CipherGuard instance
CIPHERGUARD_GATEWAY_URL=http://<VPS_A_PUBLIC_IP>:8000

# Remote Third-Party Endpoints (Hosted on separate VPS instances or external cloud)
# Example: http://203.0.113.10:8002 or https://shipfast.yourdomain.com
SHIPFAST_UPSTREAM_URL=http://<VPS_B_PUBLIC_IP>:8002
PAYFLEX_UPSTREAM_URL=http://<VPS_C_PUBLIC_IP>:8006

# Strict SSRF enforcement in production (rejects loopback and private IPs)
ALLOW_INTERNAL_NETWORKS=false

# Supabase Production Database & JWT Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_KEY=your_anon_public_key
SUPABASE_JWT_SECRET=your_jwt_secret

# Allowed CORS Origins (Vercel Frontend URLs)
ALLOWED_ORIGINS=https://dashboard.cipherguard.com,https://playground.cipherguard.com,http://localhost:3000
